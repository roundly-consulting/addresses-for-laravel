parameters:
    level: 7
    paths:
        - src
        - config
        - database
        - tests/TestModel.php
        - tests/Support
    excludePaths:
        # Consumer-facing opt-in trait; it is only used from test cases (which
        # are not analysed) and host applications, so it has no static caller here.
        - src/Testing/InteractsWithAddresses.php
    configDirectories:
        - config
    checkModelProperties: true
